
# Config generated by Ghostty Config
# https://ghostty.zerebos.com

clipboard-read = allow
macos-icon = retro
# selection-background = cell-foreground
# selection-foreground = cell-background
theme = light:Rose Pine Dawn,dark:Rose Pine
# theme = Rose Pine
font-family = Fira Code
font-size = 17

# Comfortable, balanced layout
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

# Subtle glass effect — reduce opacity/blur if it feels distracting
background-opacity = 0.93
background-opacity-cells = true
background-blur = 20
macos-titlebar-style = transparent

# Better cursor and mouse behaviour
cursor-style = bar
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true
scroll-to-bottom = keystroke
mouse-scroll-multiplier = precision:0.8,discrete:2

# Practical terminal workflow
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
scrollback-limit = 50000000
scrollbar = never
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# Font polish
font-feature = calt
bold-color = bright


